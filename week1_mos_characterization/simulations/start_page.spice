* expanding   symbol:  sg13g2_tests/tran_moscap_n.sym # of pins=0
** sym_path: /foss/pdks/ihp-sg13g2/libs.tech/xschem/sg13g2_tests/tran_moscap_n.sym
** sch_path: /foss/pdks/ihp-sg13g2/libs.tech/xschem/sg13g2_tests/tran_moscap_n.sch
.subckt tran_moscap_n
**** begin user architecture code


.lib cornerMOSCAP.lib moscap_tt


**** end user architecture code
**** begin user architecture code


.param  TEMP = 27
  .control
     save all
     tran 0.1n 400n
     let Cn_abs = abs(i(v1)) / deriv(v(p))
     meas tran C_max MAX Cn_abs
     meas tran C_min MIN Cn_abs from=5n to=400n
     meas tran t_c_min MIN_AT Cn_abs from=5n to=400n
     meas tran V_th FIND v(p) AT=t_c_min
     let Cn_norm = Cn_abs / C_max
     plot Cn_abs vs v(p)
     write tran_moscap_n.raw
  .endc


**** end user architecture code
V1 P GND pwl 0 -1.2 400n 1.2
XC1 P GND sg13_moscap_n w=1.0u l=1.0u m=1 mm_ok=1
.ends


* expanding   symbol:  sg13g2_tests/tran_moscap_p.sym # of pins=0
** sym_path: /foss/pdks/ihp-sg13g2/libs.tech/xschem/sg13g2_tests/tran_moscap_p.sym
** sch_path: /foss/pdks/ihp-sg13g2/libs.tech/xschem/sg13g2_tests/tran_moscap_p.sch
.subckt tran_moscap_p
**** begin user architecture code


.lib cornerMOSCAP.lib moscap_tt


**** end user architecture code
**** begin user architecture code



.control
save all
  tran 0.1n 400n
  let vcap = v(m)-v(vdd)
  let Cp_abs = abs(i(v1)) / deriv(vcap)
   meas tran C_max MAX Cp_abs
   meas tran C_min MIN Cp_abs from=5n to=400n
   meas tran t_c_min MIN_AT Cp_abs from=5n to=400n
   meas tran V_th FIND vcap AT=t_c_min
   plot Cp_abs vs vcap
  write tran_moscap_p.raw
.endc



**** end user architecture code
V1 M GND pwl 0 0 400n 2.4
XC1 M VDD sg13_moscap_p w=1u l=1u m=1 mm_ok=1
V2 VDD GND DC 1.2
.ends


